// 样例 5：分组聚合 min / max / avg 统计
// 覆盖：group_by、agg(min/max/avg/count)、全局 agg、sort、print
Table("orders.parquet") as o
  .group_by(o.category)
  .agg(
    order_count = count(),
    min_amount = min(o.amount),
    max_amount = max(o.amount),
    avg_amount = avg(o.amount),
  )
  .sort(category asc)
  .print()
