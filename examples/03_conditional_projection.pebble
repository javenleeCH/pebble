// 样例 3：if 分段函数扩展投影 + 内置函数 + 列裁剪 + 打印
// 覆盖：if 表达式、内置函数 round、extend、select、print；可选值判空
Table("scores.parquet") as s
  .filter(s.score != null)
  .extend({
    level = if s.score >= 90 { "A" }
            else if s.score >= 60 { "B" }
            else { "C" },
    rounded = round(s.score),
  })
  .select(s.id, level, rounded)
  .print()
